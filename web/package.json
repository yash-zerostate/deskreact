{
  "name": "deskdesk-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static React SPA for DeskDesk — talks to its own Express API over Bearer tokens",
  "scripts": {
    "dev": "vite --port 4003",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4003",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
