# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="deskdesk_demo"

# ── Auth ────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
# Short on purpose: the SPA holds this token, so it must age out fast.
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ── Server ──────────────────────────────────────────────────────────────────
PORT="5003"
NODE_ENV="development"

# The SPA's origin. CORS allows exactly this, with credentials (the refresh
# token travels as an httpOnly cookie even though the access token does not).
WEB_ORIGIN="http://localhost:4003"

# Refresh-cookie scope. In production on different domains you need
# COOKIE_SAMESITE=none + COOKIE_SECURE=true (HTTPS).
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"
